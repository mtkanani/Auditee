# Server configuration
PORT=8080
NODE_ENV=development
TZ="Asia/Kolkata"

# Database configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Token Expiry Configurations
ACCESS_TOKEN_EXPIRY_MINUTES=1440
REFRESH_TOKEN_EXPIRY_DAYS=7
ID_TOKEN_EXPIRY_MINUTES=60

# Frontend & CORS Configuration
FRONTEND_URL="http://localhost:5173"

# Gmail SMTP & OAuth Credentials (REPLACE WITH YOUR OWN SECRETS)
GMAIL_CLIENT_ID="YOUR_GMAIL_CLIENT_ID"
GMAIL_CLIENT_SECRET="YOUR_GMAIL_CLIENT_SECRET"
GMAIL_REFRESH_TOKEN="YOUR_GMAIL_REFRESH_TOKEN"

# File storage: Cloudflare R2 (S3-compatible). Set these in Railway, never commit real keys.
# S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
